{
  "name": "@untraced/sdk",
  "version": "0.1.0",
  "description": "Zero-knowledge identity verification SDK for Web3 applications",
  "author": "Untraced Team",
  "license": "MIT",
  "homepage": "https://untraced.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/untraced/sdk.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/untraced/sdk/issues"
  },
  "keywords": [
    "zero-knowledge",
    "zk",
    "identity",
    "verification",
    "web3",
    "ethereum",
    "mantle",
    "oauth",
    "attestation",
    "privacy"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./modal": {
      "types": "./dist/modal/index.d.ts",
      "import": "./dist/modal/index.js",
      "require": "./dist/modal/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "bun run build",
    "lint": "eslint src/"
  },
  "dependencies": {
    "viem": "^2.21.54",
    "@privy-io/react-auth": "^2.0.5"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
